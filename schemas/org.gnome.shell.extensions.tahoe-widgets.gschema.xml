<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.tahoe-widgets"
          path="/org/gnome/shell/extensions/tahoe-widgets/">

    <!-- ══ Widget Registry ═══════════════════════════════════════════ -->
    <key name="active-widgets" type="as">
      <default>[]</default>
      <summary>List of currently active widget IDs (empty on first run)</summary>
    </key>

    <!-- ══ Widget State (JSON blob per widget) ═══════════════════════ -->
    <key name="widget-states" type="s">
      <default>"{}"</default>
      <summary>JSON: { widgetId: { x, y, visible, width, height } }</summary>
    </key>

    <!-- ══ Visual ════════════════════════════════════════════════════ -->
    <key name="blur-radius" type="i">
      <range min="0" max="60"/>
      <default>20</default>
      <summary>Blur sigma for glassmorphism effect</summary>
    </key>

    <key name="panel-opacity" type="d">
      <range min="0.05" max="0.95"/>
      <default>0.18</default>
      <summary>Widget background fill opacity</summary>
    </key>

    <key name="corner-radius" type="i">
      <range min="4" max="36"/>
      <default>20</default>
      <summary>Corner radius in pixels</summary>
    </key>

    <key name="widget-spacing" type="i">
      <range min="4" max="64"/>
      <default>16</default>
      <summary>Default gap between widgets when auto-placed</summary>
    </key>

    <key name="color-scheme" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>"auto"</default>
      <summary>Widget color scheme</summary>
    </key>

    <!-- ══ Layout ════════════════════════════════════════════════════ -->
    <key name="snap-to-grid" type="b">
      <default>true</default>
      <summary>Snap widgets to grid when dragging</summary>
    </key>

    <key name="grid-size" type="i">
      <range min="4" max="64"/>
      <default>8</default>
      <summary>Snap grid size in pixels</summary>
    </key>

    <key name="top-bar-margin" type="i">
      <range min="0" max="120"/>
      <default>40</default>
      <summary>Pixels reserved below top bar</summary>
    </key>

    <key name="dock-margin" type="i">
      <range min="0" max="200"/>
      <default>72</default>
      <summary>Pixels reserved above dock / bottom panel</summary>
    </key>

    <!-- ══ Clock ═════════════════════════════════════════════════════ -->
    <key name="clock-format" type="s">
      <choices>
        <choice value="12h"/>
        <choice value="24h"/>
      </choices>
      <default>"12h"</default>
      <summary>Clock time format</summary>
    </key>

    <key name="clock-show-seconds" type="b">
      <default>false</default>
      <summary>Show seconds in clock</summary>
    </key>

    <!-- ══ Weather ═══════════════════════════════════════════════════ -->
    <key name="weather-location" type="s">
      <default>""</default>
      <summary>City name (blank = auto via Geoclue)</summary>
    </key>

    <key name="weather-unit" type="s">
      <choices>
        <choice value="celsius"/>
        <choice value="fahrenheit"/>
      </choices>
      <default>"celsius"</default>
      <summary>Temperature unit</summary>
    </key>

    <key name="weather-refresh-minutes" type="i">
      <range min="5" max="120"/>
      <default>15</default>
      <summary>Weather data refresh interval in minutes</summary>
    </key>

    <!-- ══ World Clock ═══════════════════════════════════════════════ -->
    <key name="world-clock-zones" type="as">
      <default>["America/New_York","Europe/London","Asia/Tokyo","Australia/Sydney"]</default>
      <summary>IANA timezone IDs for world clock</summary>
    </key>

    <!-- ══ First run ═════════════════════════════════════════════════ -->
    <key name="first-run" type="b">
      <default>true</default>
      <summary>Show onboarding on first enable</summary>
    </key>

  </schema>
</schemalist>
